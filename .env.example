# Local Docker development only. Copy to .env and supply every blank value.
# Local PowerShell scripts separately use .work/dev.env.json.
# SA: use a strong 16+ character password without semicolon, quote or dollar sign.
MSSQL_SA_PASSWORD=
# Runtime SQL password: 16-128 characters from A-Z a-z 0-9 @%_+=:,.-,
# including uppercase, lowercase, digit and symbol (SQL Server complexity).
ERP_DB_PASSWORD=
# Base64-encoded random key containing at least 32 random bytes.
ERP_SIGNING_KEY=
ERP_ADMIN_EMAIL=
ERP_ADMIN_PASSWORD=
# Loopback HTTP port; match ERP_PUBLIC_ORIGIN when changing this.
ERP_WEB_PORT=5186
# Exact browser origin, no trailing slash.
ERP_PUBLIC_ORIGIN=http://localhost:5186
