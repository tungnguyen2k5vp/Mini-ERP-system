FROM mcr.microsoft.com/dotnet/sdk:10.0.102 AS build
WORKDIR /source
COPY global.json Directory.Build.props Directory.Packages.props MiniErp.sln ./
COPY backend/ backend/
RUN dotnet restore backend/src/MiniErp.Api/MiniErp.Api.csproj --locked-mode
RUN dotnet publish backend/src/MiniErp.Api/MiniErp.Api.csproj -c Release --no-restore -o /app /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/ ./
ENV ASPNETCORE_HTTP_PORTS=8080
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "MiniErp.Api.dll"]
